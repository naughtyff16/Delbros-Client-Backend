{
  "name": "delbros-portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Delbros Leasing — Client & Vendor Portal backend (Node.js + Express + MySQL stored procedures)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "gen-keys": "node -e \"const c=require('crypto');console.log('PII_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'));console.log('PII_HASH_KEY='+c.randomBytes(32).toString('base64'));console.log('SESSION_SECRET='+c.randomBytes(48).toString('base64'))\"",
    "test": "node --test --test-concurrency=1 test/",
    "sample-data": "node database/sample/generate-sample-data.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "log4js": "^6.9.1",
    "mysql2": "^3.11.5"
  }
}
