# ─────────────────────────────────────────────────────────────────────────────────────────────
# Delbros portal backend — environment variables. Copy to App/.env and fill in.
# NEVER commit App/.env. On the EC2 server this file is the only place for these values: owner = the service user,
# permissions 600 (chmod 600 App/.env). Keep an offline copy of PII_ENCRYPTION_KEY / PII_HASH_KEY separate from the DB backups.
# Generate keys:  npm run gen-keys
# ─────────────────────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
# Number of proxies in front of the app (1 = Nginx on the same server) — needed for secure cookies and client IPs
TRUST_PROXY=1

# Portal address (served by Nginx on the same EC2 server) — used for CORS and for links in emails
PORTAL_URL=https://portal.example.com
CORS_ORIGINS=https://portal.example.com

# ── MySQL (Amazon RDS) ───────────────────────────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=delbros_portal
# API account: EXECUTE on procedures only (99_security.sql)
DB_USER=portal_app
DB_PASSWORD=change-me
# Session store account: sessions table only
DB_SESSION_USER=portal_session
DB_SESSION_PASSWORD=change-me
DB_SSL=true
DB_POOL_SIZE=10

# ── Sessions ─────────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=generate-with-npm-run-gen-keys
SESSION_COOKIE_NAME=dlb.sid
# Portal idle timeout (minutes) — keep equal to setting auth.portal_session_timeout_minutes
SESSION_IDLE_MINUTES=15
COOKIE_SECURE=true
# lax: the portal and the API are on the same domain (Nginx serves both)
COOKIE_SAMESITE=lax
# DEVELOPMENT ONLY: return emailed sign-in codes / reset and approval links in API responses (demo box). Ignored in production.
DEV_EXPOSE_CODES=false

# ── PDPA: personal-data encryption (AES-256-GCM) and blind index (HMAC-SHA256) ──────────────
# 32 random bytes, base64. Losing PII_ENCRYPTION_KEY = losing the personal data. Back it up securely.
PII_KEY_VERSION=v1
PII_ENCRYPTION_KEY=generate-with-npm-run-gen-keys
PII_HASH_KEY=generate-with-npm-run-gen-keys
# Key rotation: put the previous key here (and its version) so old rows can still be read
PII_OLD_KEY_VERSION=
PII_OLD_ENCRYPTION_KEY=

# ── Passwords ────────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Amazon SES (email) ─────────────────────────────────────────────────────────────────────────
# On EC2 the SDK uses the instance IAM role (permission ses:SendEmail) — do not put AWS access keys here.
AWS_REGION=ap-southeast-1
# Verified SES sender. Required in UAT / production.
SES_FROM_ADDRESS=no-reply@delbros.com

# ── Uploaded files (stored on this server) ─────────────────────────────────────────────────────
# Absolute path (or relative to the project folder). Keep it OUTSIDE the web root and include it in the server backups.
FILE_DIR=/var/delbros/uploads
# Lifetime of a signed download link (seconds)
FILE_LINK_SECONDS=300

# ── Background jobs (EWA expiry, auto hold, contract expiry, email outbox sender) ──────
# true on exactly ONE instance
RUN_JOBS=true

# ── Logs (log4js) — app.log = info and above, error.log = errors only ───────────────────────
# A new file starts every day AND whenever the current file reaches LOG_MAX_SIZE_MB (allowed 2–5).
# Rolled files: app.2026-11-19.log, app.2026-11-19.1.log … compressed; oldest deleted beyond LOG_MAX_FILES.
# No personal data is ever written (emails, phones, TINs, names, tokens are filtered out).
LOG_LEVEL=info
LOG_DIR=/var/delbros/logs
LOG_MAX_SIZE_MB=5
LOG_MAX_FILES=100
LOG_MAX_ERROR_FILES=100
# Stored procedures slower than this are logged as warnings
LOG_SLOW_PROCEDURE_MS=2000
